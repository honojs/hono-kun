{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "hono-kun-github",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-01",
  "workers_dev": false,
  "routes": [{ "pattern": "hono-kun-github.hono.dev", "custom_domain": true }],
  "observability": { "enabled": true },
  "kv_namespaces": [
    { "binding": "DELIVERIES", "id": "8547d35113874ca68efc679c98df8388" },
  ],
  "services": [{ "binding": "AGENTS", "service": "hono-kun-agents" }],
}
